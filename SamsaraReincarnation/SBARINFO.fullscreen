                else IsSelected Mauler2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                else { DrawString "fonts/goodolhud_font.bmf", Untranslated, WeaponTag, -6, -25, 2, Alignment(Right), DrawShadow; }
            }
        }

        // Selected inventory
        IfCVarInt goh_alwaysshowinventorycounter, 1, equal
        {
            IfCVarInt goh_showweaponname, 1, equal
            {
                InInventory DescentClass { DrawSelectedInventory AlwaysShowCounter, INDEXFONT, -253, -73, -217, -48, White; }
                else { DrawSelectedInventory AlwaysShowCounter, INDEXFONT, -253, -57, -217, -32, White; }
            }
            else { DrawSelectedInventory AlwaysShowCounter, INDEXFONT, -253, -41, -217, -16, White; }
        } else {
            IfCVarInt goh_showweaponname, 1, equal { DrawSelectedInventory INDEXFONT, -253, -57, -217, -32, White; }
            else { DrawSelectedInventory INDEXFONT, -253, -41, -217, -16, White; }
        }

        // Equipment bar
        InInventory ExpandedHud
        {
            IfCVarInt goh_showweaponname, 1, equal
            {
                InInventory DescentClass
                {
                    // Slot 1
                    InInventory WolfenClass
                    {
                        InInventory WolfenClassMode, 2 // Castle Totenkopf SDL
                        {
                            InInventory GotWeapon0 || Totenkopf_MauserDual { DrawImage "STYSNUM1", -343, -54; }
                        } else { // Original/Lost Episodes
                            InInventory GotWeapon0 { DrawImage "STYSNUM1", -343, -54; }
                        }
                    } else InInventory MarathonClass {
                        InInventory GotWeapon0 || CanDualPistols { DrawImage "STYSNUM1", -343, -54; }
                    } else InInventory WitchavenClass {
                        InInventory WTShieldTrigger { DrawImage "STYSNUM1", -343, -54; }
                    } else InInventory CatacombClass {
                        InInventory Catacomb_WavesQuickSpell { DrawImage "STYSNUM1", -343, -54; }
                    } else InInventory RTCWClass {
                        InInventory GotWeapon0 || RTCW_Pineapple { DrawImage "STYSNUM1", -343, -54; }
                    } else InInventory DescentClass {
                        InInventory DescentSecondaryTrigger
                        {
                            InInventory GotWeapon0 { DrawImage "STYSNUM1", -343, -54; }
                        } else {
                            InInventory DescentLaserLevel, 4 { DrawImage "STYSNUM1", -343, -54; }
                        }
                    } else {
                        InInventory GotWeapon0 { DrawImage "STYSNUM1", -343, -54; }
                    }

                    IsSelected " Chainsaw " { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected "Super Bootspork" { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected "Gauntlets of the Necromancer" { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Knife
                    {
                        InInventory BJSuperKnife { DrawImage "STY2NUM1", -343, -54; }
                    }
                    IsSelected Totenkopf_Mauser, Totenkopf_MauserDual { DrawImage "STY2NUM1", -343, -54; }
                    InInventory HexenClassMode, 3 // Baratus
                    {
                        InInventory Flechette3Cooldown, 5 { DrawImage "STY2NUM1", -343, -54; }
                    } else InInventory HexenClassMode, 2 { // Daedolon
                        InInventory Flechette2Cooldown, 12 { DrawImage "STY2NUM1", -343, -54; }
                    } else { // Parias (Reincarnation/Classic)
                        InInventory FlechetteCooldown, 9 { DrawImage "STY2NUM1", -343, -54; }
                    }
                    IsSelected Pipebombs { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected "KKV-7 SMG Flechette" { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected ".44 Magnum Mega Class A1"
                    {
                        InInventory UsingDualPistols { DrawImage "STY2NUM1", -343, -54; }
                    }
                    IsSelected Mjolnir { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Bazooka { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected "Auto Charge Pistol"
                    {
                        InInventory BlakeSuperAutoCharge { DrawImage "STY2NUM1", -343, -54; }
                    }
                    IsSelected Dynamite { DrawImage "STY2NUM1", -343, -54; }
                    InInventory StrifeBeaconCooldown, 101 { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected " Arachnicator ", EradRovingMine { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected EradMiniTankDetonator { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected M24CAW { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Dirtshark
                    {
                        InInventory SamsaraRMRDirtsharkUpgrade { DrawImage "STY2NUM1", -343, -54; }
                    }
                    IsSelected "Thermal Detonator" { DrawImage "STY2NUM1", -343, -54; }
                    InInventory IPOGGrenadeCooldown { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected " 18mm Semi "
                    {
                        InInventory SamsaraDisruptorHas18mmAuto { DrawImage "STY2NUM1", -343, -54; }
                    }
                    InInventory WTShieldActive { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Hornetgun, "Shock Roach" { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected SWSticky { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected CMDarklightFoil { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected " Anubis Mine " { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected " RR Rip Saw " { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Q2Machinegun { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Hexen2IceMace { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Goldeneye_ThrowingKnives { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Goldfinger_OddjobHat { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Catacomb_WavesQuickSpell { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Painkiller_Stakegun { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Unreal_Razorjack { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected RTCW_Grenade, RTCW_Pineapple { DrawImage "STY2NUM1", -343, -54; }
                    IsSelected Q3GrenadeLauncher { DrawImage "STY2NUM1", -343, -54; }
                    InInventory DescentSecondaryTrigger
                    {
                        InInventory DescentSecondaryCounter, 2 {}
                        else InInventory DescentSecondaryCounter, 1 { DrawImage "STY2NUM1", -343, -54; }
                    } else {
                        InInventory DescentPrimaryCounter, 2 {}
                        else InInventory DescentPrimaryCounter, 1 { DrawImage "STY2NUM1", -343, -54; }
                    }
                    IsSelected DeusEx_MiniCrossbow { DrawImage "STY2NUM1", -343, -54; }

                    InInventory HexenClassMode, 3 // Baratus
                    {
                        InInventory Flechette3Cooldown { DrawNumber 3, INDEXFONT, Red, Flechette3Cooldown, -335, -48; }
                    } else InInventory HexenClassMode, 2 { // Daedolon
                        InInventory Flechette2Cooldown { DrawNumber 3, INDEXFONT, Red, Flechette2Cooldown, -335, -48; }
                    } else { // Parias (Reincarnation/Classic)
                        InInventory FlechetteCooldown { DrawNumber 3, INDEXFONT, Red, FlechetteCooldown, -335, -48; }
