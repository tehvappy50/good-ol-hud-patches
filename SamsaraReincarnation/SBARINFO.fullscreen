StatusBar Fullscreen, FullscreenOffsets
{
    InInventory not BondWatchToken
    {
        // "Background".

        // Visual effects
        //InInventory KatarnClass { DrawSwitchableImage PowerIronFeetNoColor, "KYLEMSK0", "KYLEMSK1", 0, 0; } // can't get this to work reliably

        InInventory DescentClass
        {
            InInventory DescentMissileCamera { DrawImage "DSMISCAM", -32 + Center, -54; }
            else InInventory DescentMissileStaticToken { DrawImage "DESSTAT1", -32 + Center, -65; }
        }

        // Center.

        // New fullscreen HUD warning
        InInventory RottClass || HalfLifeClass
        {
            InInventory SamsaraUsingNewFullscreenHUD { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WARNING_SAMSARA_NEWFULLSCREENHUD", 0 + Center, 0 + Center, 2, Alignment(Center), DrawShadow; }
        } else InInventory BondClass || PainkillerClass {
            InInventory SamsaraUsingNewFullscreenHUD { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WARNING_SAMSARA_NEWFULLSCREENHUD", 0 + Center, 0 + Center, 2, Alignment(Center), DrawShadow; }
        } else InInventory Q3Class || DescentClass {
            InInventory SamsaraUsingNewFullscreenHUD { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WARNING_SAMSARA_NEWFULLSCREENHUD", 0 + Center, 0 + Center, 2, Alignment(Center), DrawShadow; }
        }

        // Bottom right.

        // Primary ammo
        InInventory DescentClass
        {
            InInventory DescentPrimaryCounter, 9 // Phoenix Cannon
            {
                IfCVarInt goh_showweaponname, 1, equal
                {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -59; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -59; }

                    DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Left), DrawShadow, -38, -57, 2;
                } else {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -27; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -27; }

                    DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Left), DrawShadow, -38, -25, 2;
                }
            } else InInventory DescentPrimaryCounter, 8 { // Plasma Cannon
                IfCVarInt goh_showweaponname, 1, equal
                {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }

                    DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -57, 2;
                } else {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }

                    DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -25, 2;
                }
            } else InInventory DescentPrimaryCounter, 7 { // Omega Cannon
                IfCVarInt goh_showweaponname, 1, equal
                {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -59; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -59; }

                    DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Left), DrawShadow, -38, -57, 2;
                } else {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -27; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -27; }

                    DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Left), DrawShadow, -38, -25, 2;
                }
            } else InInventory DescentPrimaryCounter, 6 { // Helix Cannon
                IfCVarInt goh_showweaponname, 1, equal
                {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }

                    DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -57, 2;
                } else {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }

                    DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -25, 2;
                }
            } else InInventory DescentPrimaryCounter, 5 { // Fusion Cannon
                IfCVarInt goh_showweaponname, 1, equal
                {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -59; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -59; }

                    DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Left), DrawShadow, -38, -57, 2;
                } else {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -27; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_lightblue.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Cell, Horizontal, -192, -27; }

                    DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Left), DrawShadow, -38, -25, 2;
                }
            } else InInventory DescentPrimaryCounter, 2 { // Vulcan Cannon/Gauss Cannon/Spreadfire Cannon
                IfCVarInt goh_showweaponname, 1, equal
                {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }

                    DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -57, 2;
                } else {
                    IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                    else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }
                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }

                    DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -25, 2;
                }
            } else { // Laser Cannon (normal and super)
                InInventory PistolModeOn
                {
                    IfCVarInt goh_showweaponname, 1, equal
                    {
                        IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                        else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                        IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }
                        else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -59; }

                        DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -57, 2;
                    } else {
                        IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                        else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                        IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_yellow.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }
                        else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_yellow.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Clip, Horizontal, -192, -27; }

                        DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Left), DrawShadow, -38, -25, 2;
                    }
                }
            }

            InInventory DescentSecondaryCounter, 8 // Proximity Bombs/Smart Mines
            {
                InInventory DescentPrimaryCounter, 2 {}
                else
                {
                    InInventory not PistolModeOn
                    {
                        IfCVarInt goh_showweaponname, 1, equal
                        {
                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                            IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_red.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Shell, Horizontal, -192, -59; }
                            else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_red.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Shell, Horizontal, -192, -59; }

                            DrawString "fonts/goodolhud_font.bmf", Red, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
                            DrawNumber 4, "fonts/goodolhud_font.bmf", Red, Ammo Shell, Alignment(Left), DrawShadow, -38, -57, 2;
                        } else {
                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -28; }
                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -28; }

                            IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_red.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo Shell, Horizontal, -192, -27; }
                            else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_red.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo Shell, Horizontal, -192, -27; }

                            DrawString "fonts/goodolhud_font.bmf", Red, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
                            DrawNumber 4, "fonts/goodolhud_font.bmf", Red, Ammo Shell, Alignment(Left), DrawShadow, -38, -25, 2;
                        }
                    }
                }
            } else InInventory DescentSecondaryCounter, 7 { // Earthshaker Missiles
                InInventory DescentPrimaryCounter, 2 {}
                else
                {
                    InInventory not PistolModeOn
                    {
                        IfCVarInt goh_showweaponname, 1, equal
                        {
                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", -193, -60; }
                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", -193, -60; }

                            IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_brown.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo RocketAmmo, Horizontal, -192, -59; }
                            else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_brown.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo RocketAmmo, Horizontal, -192, -59; }

                            DrawString "fonts/goodolhud_font.bmf", Brown, "$GOODOLHUD_AMMO1", -199, -57, 2, Alignment(Right), DrawShadow;
