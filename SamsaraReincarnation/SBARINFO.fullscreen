                            IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_brown.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Ammo RocketAmmo, Horizontal, -192, -27; }
                            else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_brown.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Ammo RocketAmmo, Horizontal, -192, -27; }

                            DrawString "fonts/goodolhud_font.bmf", Brown, "$GOODOLHUD_AMMO1", -199, -25, 2, Alignment(Right), DrawShadow;
