                    else InInventory EradMode, 2 { DrawImage "TPCHERA3_HUD", 8, -58; }
                    else InInventory EradMode, 1 { DrawImage "TPCHERA2_HUD", 8, -58; }
                    else { DrawImage "TPCHERAD_HUD", 8, -58; }
                }
                else InInventory C7Class { DrawImage "TPCHCOR7_HUD", 8, -58; }
                else InInventory RMRClass { DrawImage "TPCHRMR_HUD", 8, -58; }
                else InInventory KatarnClass { DrawImage "TPCHKYLE_HUD", 8, -58; }
                else InInventory POGreedClass
                {
