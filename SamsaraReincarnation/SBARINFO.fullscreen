        // Player/character name
        GameMode SinglePlayer, Cooperative
        {
            IfCVarInt goh_showplayername, 1, equal
            {
                IfCVarInt goh_samsara_showcharactername, 1, equal
                {
                    InInventory DoomguyClass
                    {
                        InInventory DoomClassMode, 2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_DOOMGUYSTR", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory DoomClassMode, 1 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_DOOMGUY64", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_DOOMGUY", 4, -25, 2, Alignment(Left), DrawShadow; }
                    }
                    else InInventory ChexClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_CHEX", 4, -25, 2, Alignment(Left), DrawShadow; }
                    else InInventory CorvusClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_CORVUS", 4, -25, 2, Alignment(Left), DrawShadow; }
                    else InInventory WolfenClass
                    {
                        InInventory WolfenClassMode, 2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_BJCTK", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory WolfenClassMode, 1 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_BJLOST", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_BJ", 4, -25, 2, Alignment(Left), DrawShadow; }
                    } else InInventory HexenClass {
                        InInventory HexenClassMode, 3 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_BARATUS", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory HexenClassMode, 2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_DAEDOLON", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory HexenClassMode, 1 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_PARIASCLASSIC", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_PARIAS", 4, -25, 2, Alignment(Left), DrawShadow; }
                    } else InInventory DukeClass {
