                else { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_PYROGX_FALLBACKRANGEDB", -6, -41, 2, Alignment(Right), DrawShadow; }
            } else InInventory DeusExClass {
                IsSelected DeusEx_MiniCrossbow
