                        DrawNumber 4, "fonts/goodolhud_font.bmf", Brown, AmmoCapacity RocketAmmo, Alignment(Left), DrawShadow, -151, -41, 2;

                        DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMOCAPACITY_SAMSARA_AMMO4", -199, -25, 2, Alignment(Right), DrawShadow;
                        DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_SEPARATOR", -151, -25, 2, Alignment(Right), DrawShadow;

                        DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Right), DrawShadow, -159, -25, 2;
