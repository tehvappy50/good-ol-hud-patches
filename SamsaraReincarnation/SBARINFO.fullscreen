                        else InInventory PainkillerClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_DANIEL", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory UnrealClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_PRISONER", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory RTCWClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_RTCW", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory Q3Class { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_SARGE", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory DescentClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_PYROGX", 4, -25, 2, Alignment(Left), DrawShadow; }
                        else InInventory DeusExClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_JCDENTON", 4, -25, 2, Alignment(Left), DrawShadow; }
