                    else InInventory RottMode, 3 { DrawImage "TPCHLLNI_HUD", 8, -58; }
                    else InInventory RottMode, 2 { DrawImage "TPCHTBAR_HUD", 8, -58; }
                    else InInventory RottMode, 1 { DrawImage "TPCHTCAS_HUD", 8, -58; }
                    else { DrawImage "TPCHROTT_HUD", 8, -58; }
