                        else InInventory WitchavenClass { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_CHARACTER_SAMSARA_GRONDOVAL", 4, -25, 2, Alignment(Left), DrawShadow; }
