                        DrawNumber 4, "fonts/goodolhud_font.bmf", Brown, AmmoCapacity RocketAmmo, Alignment(Left), DrawShadow, -151, -73, 2;

                        DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMOCAPACITY_SAMSARA_AMMO4", -199, -57, 2, Alignment(Right), DrawShadow;
