            IfCVarInt goh_showtimer, 1, equal
            {
                IfCVarInt goh_showmonstercounter, 1, equal
                {
                    IfCVarInt goh_showsecretcounter, 1, equal
                    {
                        IfCVarInt goh_showitemcounter, 1, equal { DrawKeyBar 100, Vertical, Auto, -26, 84; }
                        else { DrawKeyBar 100, Vertical, Auto, -26, 68; }
                    }
