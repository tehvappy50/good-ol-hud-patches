                            else InInventory DukeClassMode, 1 { DrawImage "STE2_HUD", -66, 210, Center; } // Life's a Beach
                            else { DrawImage "STER_HUD", -66, 210, Center; } // Original

                            DrawNumber 4, "fonts/goodolhud_font.bmf", DarkBrown, DukeSteroidsFuel, Alignment(Center), DrawShadow, -67, 234, 2;
                        } else {
                            InInventory DukeClassMode, 2 { DrawImage "STE3_HUD", -66, 194, Center; } // Duke Nukem 64
                            else InInventory DukeClassMode, 1 { DrawImage "STE2_HUD", -66, 194, Center; } // Life's a Beach
                            else { DrawImage "STER_HUD", -66, 194, Center; } // Original

                            DrawNumber 4, "fonts/goodolhud_font.bmf", DarkBrown, DukeSteroidsFuel, Alignment(Center), DrawShadow, -67, 218, 2;
                        }
                    } else InInventory DukeVisionFuel || DukeJetpackFuel {
                        IfCVarInt goh_showtimer, 1, equal
                        {
                            InInventory DukeClassMode, 2 { DrawImage "STE3_HUD", -66, 142, Center; } // Duke Nukem 64
                            else InInventory DukeClassMode, 1 { DrawImage "STE2_HUD", -66, 142, Center; } // Life's a Beach
                            else { DrawImage "STER_HUD", -66, 142, Center; } // Original

                            DrawNumber 4, "fonts/goodolhud_font.bmf", DarkBrown, DukeSteroidsFuel, Alignment(Center), DrawShadow, -67, 166, 2;
                        } else {
                            InInventory DukeClassMode, 2 { DrawImage "STE3_HUD", -66, 126, Center; } // Duke Nukem 64
                            else InInventory DukeClassMode, 1 { DrawImage "STE2_HUD", -66, 126, Center; } // Life's a Beach
                            else { DrawImage "STER_HUD", -66, 126, Center; } // Original

                            DrawNumber 4, "fonts/goodolhud_font.bmf", DarkBrown, DukeSteroidsFuel, Alignment(Center), DrawShadow, -67, 150, 2;
                        }
                    } else {
                        IfCVarInt goh_showtimer, 1, equal
                        {
                            InInventory DukeClassMode, 2 { DrawImage "STE3_HUD", -66, 74, Center; } // Duke Nukem 64
                            else InInventory DukeClassMode, 1 { DrawImage "STE2_HUD", -66, 74, Center; } // Life's a Beach
                            else { DrawImage "STER_HUD", -66, 74, Center; } // Original

                            DrawNumber 4, "fonts/goodolhud_font.bmf", DarkBrown, DukeSteroidsFuel, Alignment(Center), DrawShadow, -67, 98, 2;
                        } else {
                            InInventory DukeClassMode, 2 { DrawImage "STE3_HUD", -66, 58, Center; } // Duke Nukem 64
                            else InInventory DukeClassMode, 1 { DrawImage "STE2_HUD", -66, 58, Center; } // Life's a Beach
                            else { DrawImage "STER_HUD", -66, 58, Center; } // Original

                            DrawNumber 4, "fonts/goodolhud_font.bmf", DarkBrown, DukeSteroidsFuel, Alignment(Center), DrawShadow, -67, 82, 2;
                        }
                    }
                }
            }

            InInventory CalebClass
            {
                InInventory CalebVisionFuel
                {
                    IfCVarInt goh_showtimer, 1, equal
                    {
                        DrawImage "INBEAST", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Cream, CalebVisionFuel, Alignment(Center), DrawShadow, -67, 98, 2;
                    } else {
