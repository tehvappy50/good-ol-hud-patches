                IsSelected "B.F.G. 9000", "B.F.G. 2704" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "Calamity Blade", " Unmaker " { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "Pyro Cannon" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "LAZ Device" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected DSparilStaff, DSparilStaffMinion { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "Spear of Destiny" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Totenkopf_Flakgun { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Wraithverge, Bloodscourge { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Quietus { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "Devastator Weapon" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "ONI-71 Wave Motion Cannon" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Thunderbolt, "Thunderbolt DOE" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected FlameWall { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "Anti-Plasma Cannon" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected LifeLeech { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " Mauler ", " Mauler Torpedo " { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " Plasma Ball " { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "AlienDisintegrator" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " RMR Plasma Cannon ", "Subestron Arm" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "Assault Cannon" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " Super Plasma Annihilator " { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " Disruptor Zodiac " { DrawImage "STY2NUM7", -295, -22; } // weapons take priority over inventory items
                else InInventory DisruptorTeraBall
                {
                    InInventory DisruptorBlastExists { DrawImage "STY2NUM7", -295, -22; }
                }
                IsSelected "Pike Axe" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected "E.G.O.N.", "Displacer Cannon" { DrawImage "STY2NUM7", -295, -22; }
                IsSelected SWGuardianHead { DrawImage "STY2NUM7", -295, -22; }
                IsSelected SWMissileLauncher
                {
                    InInventory MissileMode, 2 { DrawImage "STY2NUM7", -295, -22; }
                }
                IsSelected CMPlasmaGun { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " Mummy Staff " { DrawImage "STY2NUM7", -295, -22; }
                IsSelected " Alien Arm Cannon " { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Q2BFG10K { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Hexen2TempestStaff { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Goldeneye_Moonraker { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Goldfinger_Laser { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Catacomb_AtomicQuickSpell { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Unreal_Redeemer { DrawImage "STY2NUM7", -295, -22; }
                IsSelected RTCW_TeslaGun { DrawImage "STY2NUM7", -295, -22; }
                IsSelected Q3BFG10K { DrawImage "STY2NUM7", -295, -22; }
                InInventory DescentSecondaryTrigger
                {
                    InInventory DescentSecondaryCounter, 8 {}
                    else InInventory DescentSecondaryCounter, 7 { DrawImage "STY2NUM7", -295, -22; }
                } else {
                    InInventory DescentPrimaryCounter, 8 {}
                    else InInventory DescentPrimaryCounter, 7 { DrawImage "STY2NUM7", -295, -22; }
                }
                IsSelected DeusEx_MJ12PlasmaRifle { DrawImage "STY2NUM7", -295, -22; }

                InInventory DisruptorPSICooldown
                {
                    InInventory DisruptorPsionicSelected, 3 { DrawNumber 3, INDEXFONT, Red, DisruptorPSICooldown, -287, -22; }
                }

                IsSelected " BFG10K " { DrawImage "STY3NUM7", -295, -22; }
                IsSelected "Liquid Zorcher" { DrawImage "STY3NUM7", -295, -22; }
                IsSelected " Bloodscourge " { DrawImage "STY3NUM7", -295, -22; }
                IsSelected BloodNaturomDemonto { DrawImage "STY3NUM7", -295, -22; }
                IsSelected "Wookie Bowcaster" { DrawImage "STY3NUM7", -295, -22; }
                IsSelected Q2Trap { DrawImage "STY3NUM7", -295, -22; }
                IsSelected Goldeneye_GoldenGun { DrawImage "STY3NUM7", -295, -22; }
                IsSelected Goldfinger_M14 { DrawImage "STY3NUM7", -295, -22; }
                IsSelected Unreal_QuadShot { DrawImage "STY3NUM7", -295, -22; }
                IsSelected RTCW_Flamethrower { DrawImage "STY3NUM7", -295, -22; }

                // Inventory cooldowns
                InInventory not PowerHereticTome
                {
                    InInventory TomeOfPowerCooldown { DrawNumber 4, INDEXFONT, Black, TomeOfPowerCooldown, -238, -50; }
                }
                InInventory SamsaraDiscOfRepulsionCooldown
                {
                    InInventory SamsaraDarkServantCooldown { DrawNumber 3, INDEXFONT, Yellow, SamsaraDiscOfRepulsionCooldown, -238, -58; }
                    else { DrawNumber 3, INDEXFONT, Yellow, SamsaraDiscOfRepulsionCooldown, -238, -50; }
                }
                InInventory SamsaraDarkServantCooldown { DrawNumber 3, INDEXFONT, DarkBrown, SamsaraDarkServantCooldown, -238, -50; }
                InInventory HolodukeCooldown { DrawNumber 3, INDEXFONT, Gray, HolodukeCooldown, -238, -50; }
                InInventory SamsaraQuadDamageCooldownDisplay { DrawNumber 3, INDEXFONT, Ice, SamsaraQuadDamageCooldownDisplay, -238, -50; }
                InInventory SamsaraBloodGunsAkimboHUDDisplay, 3 {}
                else InInventory SamsaraBloodGunsAkimboHUDDisplay, 2
                {
                    InInventory SamsaraBloodGunsAkimboCooldown { DrawNumber 3, INDEXFONT, DarkGray, SamsaraBloodGunsAkimboCooldown, -238, -50; }
                }
                InInventory Hexen2TomeOfPowerCooldown { DrawNumber 3, INDEXFONT, Black, Hexen2TomeOfPowerCooldown, -238, -50; }
                InInventory Catacomb_HourglassCooldown { DrawNumber 3, INDEXFONT, Brick, Catacomb_HourglassCooldown, -238, -50; }
            }
        }

        // Bottom left.

        // Character portrait
        IfCVarInt goh_samsara_showcharacterportrait, 1, equal
        {
            IfCVarInt goh_showplayername, 1, equal
            {
                IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/icons/goodolhud_icon_base.png", 6, -60; }
                else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/icons/goodolhud_icon_base.png", 6, -60; }

                InInventory DoomguyClass
                {
                    InInventory DoomClassMode, 2 { DrawImage "TPCHDOOM_HUD", 8, -58; }
                    else InInventory DoomClassMode, 1 { DrawImage "TPCHDG64_HUD", 8, -58; }
                    else { DrawImage "TPCHDOOM_HUD", 8, -58; }
                }
                else InInventory ChexClass { DrawImage "TPCHCHEX_HUD", 8, -58; }
                else InInventory CorvusClass { DrawImage "TPCHCORV_HUD", 8, -58; }
                else InInventory WolfenClass
                {
                    InInventory WolfenClassMode, 2 { DrawImage "TPCHWOL3_HUD", 8, -58; }
                    else InInventory WolfenClassMode, 1 { DrawImage "TPCHWOL2_HUD", 8, -58; }
                    else { DrawImage "TPCHWOLF_HUD", 8, -58; }
                } else InInventory HexenClass {
                    InInventory HexenClassMode, 3 { DrawImage "TPCHHEXF_HUD", 8, -58; }
                    else InInventory HexenClassMode, 2 { DrawImage "TPCHHEXM_HUD", 8, -58; }
                    else { DrawImage "TPCHHEXN_HUD", 8, -58; }
                } else InInventory DukeClass {
                    InInventory DukeClassMode, 2 { DrawImage "TPCHDUKE_HUD", 8, -58; }
                    else InInventory DukeClassMode, 1 { DrawImage "TPCHDLAB_HUD", 8, -58; }
                    else { DrawImage "TPCHDUKE_HUD", 8, -58; }
