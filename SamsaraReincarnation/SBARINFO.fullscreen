                        DrawNumber 4, "fonts/goodolhud_font.bmf", Red, AmmoCapacity Shell, Alignment(Left), DrawShadow, -151, -73, 2;

                        DrawString "fonts/goodolhud_font.bmf", Brown, "$GOODOLHUD_AMMOCAPACITY_SAMSARA_AMMO3", -199, -57, 2, Alignment(Right), DrawShadow;
                        DrawString "fonts/goodolhud_font.bmf", Brown, "$GOODOLHUD_SEPARATOR", -151, -57, 2, Alignment(Right), DrawShadow;

                        DrawNumber 4, "fonts/goodolhud_font.bmf", Brown, Ammo RocketAmmo, Alignment(Right), DrawShadow, -159, -57, 2;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Brown, AmmoCapacity RocketAmmo, Alignment(Left), DrawShadow, -151, -57, 2;

                        DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_AMMOCAPACITY_SAMSARA_AMMO4", -199, -41, 2, Alignment(Right), DrawShadow;
                        DrawString "fonts/goodolhud_font.bmf", LightBlue, "$GOODOLHUD_SEPARATOR", -151, -41, 2, Alignment(Right), DrawShadow;

                        DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo Cell, Alignment(Right), DrawShadow, -159, -41, 2;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, AmmoCapacity Cell, Alignment(Left), DrawShadow, -151, -41, 2;
                    }
                } else {
                    IfCVarInt goh_showweaponname, 1, equal
                    {
                        DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_AMMOCAPACITY_SAMSARA_AMMO1", -199, -89, 2, Alignment(Right), DrawShadow;
                        DrawString "fonts/goodolhud_font.bmf", Yellow, "$GOODOLHUD_SEPARATOR", -151, -89, 2, Alignment(Right), DrawShadow;

                        DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, Ammo Clip, Alignment(Right), DrawShadow, -159, -89, 2;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Yellow, AmmoCapacity Clip, Alignment(Left), DrawShadow, -151, -89, 2;

                        DrawString "fonts/goodolhud_font.bmf", Red, "$GOODOLHUD_AMMOCAPACITY_SAMSARA_AMMO2", -199, -73, 2, Alignment(Right), DrawShadow;
