        }

        // Weapon tag
        IfCVarInt goh_showweaponname, 1, equal
        {
            InInventory DoomguyClass
            {
                InInventory DoomClassMode, 2 // Stronghold
                {
                    IsSelected " BFG10K " { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_DOOMGUYSTR_SLOT7S", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeCrossbow { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFECROSSBOW", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeCrossbow2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFECROSSBOW2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeGrenadeLauncher { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFEGRENADELAUNCHER", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeGrenadeLauncher2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFEGRENADELAUNCHER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected Mauler { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected Mauler2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else { DrawString "fonts/goodolhud_font.bmf", Untranslated, WeaponTag, -6, -25, 2, Alignment(Right), DrawShadow; }
                } else InInventory DoomClassMode, 1 { // Doom 64
                    IsSelected " Fist " { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_DOOMGUY64_FALLBACKMELEE", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeCrossbow { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFECROSSBOW", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeCrossbow2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFECROSSBOW2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeGrenadeLauncher { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFEGRENADELAUNCHER", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeGrenadeLauncher2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFEGRENADELAUNCHER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected Mauler { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected Mauler2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else { DrawString "fonts/goodolhud_font.bmf", Untranslated, WeaponTag, -6, -25, 2, Alignment(Right), DrawShadow; }
                } else { // Original
                    IsSelected StrifeCrossbow { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFECROSSBOW", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeCrossbow2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFECROSSBOW2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeGrenadeLauncher { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFEGRENADELAUNCHER", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected StrifeGrenadeLauncher2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_STRIFEGRENADELAUNCHER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected Mauler { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else IsSelected Mauler2 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_MAULER2", -6, -25, 2, Alignment(Right), DrawShadow; }
                    else { DrawString "fonts/goodolhud_font.bmf", Untranslated, WeaponTag, -6, -25, 2, Alignment(Right), DrawShadow; }
                }
            } else InInventory DukeClass {
                InInventory DukeClassMode, 2 // Duke Nukem 64
                {
                    IsSelected "Glock 17"
                    {
                        InInventory Duke64UsingDumDums { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_DUKE64_FALLBACKRANGED_DUMDUMS", -6, -25, 2, Alignment(Right), DrawShadow; }
                        else { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_DUKE64_FALLBACKRANGED_BULLETS", -6, -25, 2, Alignment(Right), DrawShadow; }
                    } else IsSelected "  Shotgun  " {
                        InInventory Duke64UsingExplosiveShells { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_DUKE64_SLOT2_EXPLOSIVESHELLS", -6, -25, 2, Alignment(Right), DrawShadow; }
                        else { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_DUKE64_SLOT2_SHELLS", -6, -25, 2, Alignment(Right), DrawShadow; }
