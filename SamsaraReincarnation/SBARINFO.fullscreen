        }

        // Player stats
        InInventory HexenClass
        {
            IfCVarInt goh_showplayername, 1, equal
            {
                IfCVarInt goh_samsara_showcharacterportrait, 1, equal
                {
                    InInventory BasicArmor, 1
                    {
                        IfCVarInt goh_showarmorsavepercent, 1, equal
                        {
                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/bars/goodolhud_bar_base.png", 66, -76; }
                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/bars/goodolhud_bar_base.png", 66, -76; }

                            IfCVarInt goh_colorhealthoninvuln, 1, equal
                            {
                                IfInvulnerable
                                {
                                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_white.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }
                                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_white.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }

                                    DrawString "fonts/goodolhud_font.bmf", White, "$GOODOLHUD_HEALTH", 60, -73, 2, Alignment(Right), DrawShadow;

                                    InInventory PowerStrength
                                    {
                                        IfCVarInt goh_showberserk, 1, equal
                                        {
                                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/icons/goodolhud_icon_berserk.png", 221, -74; }
                                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/icons/goodolhud_icon_berserk.png", 221, -74; }

                                            DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 237, -73, 2;
                                        }
                                        else { DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 221, -73, 2; }
                                    }
                                    else { DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 221, -73, 2; }
                                } else InInventory PowerFakeInvulnerableCleric || PowerFakeInvulnerableMage {
                                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_white.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }
                                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_white.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }

                                    DrawString "fonts/goodolhud_font.bmf", White, "$GOODOLHUD_HEALTH", 60, -73, 2, Alignment(Right), DrawShadow;

                                    InInventory PowerStrength
                                    {
                                        IfCVarInt goh_showberserk, 1, equal
                                        {
                                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/icons/goodolhud_icon_berserk.png", 221, -74; }
                                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/icons/goodolhud_icon_berserk.png", 221, -74; }

                                            DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 237, -73, 2;
                                        }
                                        else { DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 221, -73, 2; }
                                    }
                                    else { DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 221, -73, 2; }
                                } else InInventory PowerFakeInvulnerableFighter {
                                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_white.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }
                                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_white.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }

                                    DrawString "fonts/goodolhud_font.bmf", White, "$GOODOLHUD_HEALTH", 60, -73, 2, Alignment(Right), DrawShadow;

                                    InInventory PowerStrength
                                    {
                                        IfCVarInt goh_showberserk, 1, equal
                                        {
                                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/icons/goodolhud_icon_berserk.png", 221, -74; }
                                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/icons/goodolhud_icon_berserk.png", 221, -74; }

                                            DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 237, -73, 2;
                                        }
                                        else { DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 221, -73, 2; }
                                    }
                                    else { DrawNumber 4, "fonts/goodolhud_font.bmf", White, Health, Alignment(Left), DrawShadow, 221, -73, 2; }
                                } else {
                                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_red.png", "graphics/hud/theme0/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }
                                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_red.png", "graphics/hud/theme1/bars/goodolhud_bar_blank.png", Health, Horizontal, 67, -75; }

                                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_healthovermax1.png", "graphics/hud/theme0/bars/goodolhud_bar_blankovermax1.png", Health SamsaraHealthOverMax, Horizontal, 67, -75; }
                                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_healthovermax1.png", "graphics/hud/theme1/bars/goodolhud_bar_blankovermax1.png", Health SamsaraHealthOverMax, Horizontal, 67, -75; }

                                    IfCVarInt not goh_theme, 1 { DrawBar "graphics/hud/theme0/bars/goodolhud_bar_healthovermax2.png", "graphics/hud/theme0/bars/goodolhud_bar_blankovermax2.png", Health SamsaraHealthOverOverMax, Horizontal, 67, -75; }
                                    else IfCVarInt goh_theme, 1 { DrawBar "graphics/hud/theme1/bars/goodolhud_bar_healthovermax2.png", "graphics/hud/theme1/bars/goodolhud_bar_blankovermax2.png", Health SamsaraHealthOverOverMax, Horizontal, 67, -75; }

                                    DrawString "fonts/goodolhud_font.bmf", Red, "$GOODOLHUD_HEALTH", 60, -73, 2, Alignment(Right), DrawShadow;

                                    InInventory PowerStrength
                                    {
                                        IfCVarInt goh_showberserk, 1, equal
                                        {
                                            IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/icons/goodolhud_icon_berserk.png", 221, -74; }
                                            else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/icons/goodolhud_icon_berserk.png", 221, -74; }

