                    else InInventory SamsaraDeusExMiniXBowAmmoType, 1 { DrawString "fonts/goodolhud_font.bmf", Untranslated, "$GOODOLHUD_WEAPON_SAMSARA_JCDENTON_SLOT1_DARTS", -6, -25, 2, Alignment(Right), DrawShadow; }
