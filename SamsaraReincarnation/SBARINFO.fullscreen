            InInventory KatarnClass
            {
                InInventory KatarnBlazeItTimer || KatarnFireRateUp
                {
                    IfCVarInt goh_showtimer, 1, equal
                    {
                        DrawImage "J9-_A0", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", DarkGray, KatarnBlazeItTimer, Alignment(Center), DrawShadow, -67, 98, 2;
                    } else {
                        DrawImage "J9-_A0", -66, 58, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", DarkGray, KatarnBlazeItTimer, Alignment(Center), DrawShadow, -67, 82, 2;
                    }
                }
            }

            InInventory DisruptorClass
            {
                IfCVarInt goh_showtimer, 1, equal
                {
                    InInventory DisruptorPsionicSelected, 3
                    {
                        DrawImage "SQ76G0", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Brick, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 98, 2;

                        /*InInventory ExpandedHud // used for slot 7B
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", Brick, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 74, 2; }
                        }*/
                    } else InInventory DisruptorPsionicSelected, 2 {
                        DrawImage "SQ76H0", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 98, 2;

                        InInventory ExpandedHud
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 74, 2; }
                        }
                    } else InInventory DisruptorPsionicSelected, 1 {
                        DrawImage "SQ75F0", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Red, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 98, 2;

                        /*InInventory ExpandedHud // doesn't run off a cooldown
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", Red, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 74, 2; }
                        }*/
                    } else {
                        DrawImage "SQ75I0", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Ice, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 98, 2;

                        InInventory ExpandedHud
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", Ice, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 74, 2; }
                        }
                    }
                } else {
                    InInventory DisruptorPsionicSelected, 3
                    {
                        DrawImage "SQ76G0", -66, 58, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Brick, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 82, 2;

                        /*InInventory ExpandedHud // used for slot 7B
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", Brick, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 58, 2; }
                        }*/
                    } else InInventory DisruptorPsionicSelected, 2 {
                        DrawImage "SQ76H0", -66, 58, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 82, 2;

                        InInventory ExpandedHud
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 58, 2; }
                        }
                    } else InInventory DisruptorPsionicSelected, 1 {
                        DrawImage "SQ75F0", -66, 58, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Red, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 82, 2;

                        /*InInventory ExpandedHud // doesn't run off a cooldown
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", Red, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 58, 2; }
                        }*/
                    } else {
                        DrawImage "SQ75I0", -66, 58, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Ice, Ammo DisruptorPSIEnergy, Alignment(Center), DrawShadow, -67, 82, 2;

                        InInventory ExpandedHud
                        {
                            InInventory DisruptorPSICooldown { DrawNumber 4, "fonts/goodolhud_font.bmf", Ice, DisruptorPSICooldown, Alignment(Right), DrawShadow, -83, 58, 2; }
                        }
                    }
                }
            }

            InInventory HalfLifeClass // NIVI_HUD is placeholder
            {
                IfCVarInt goh_showtimer, 1, equal
                {
                    DrawImage "NIVI_HUD", -66, 74, Center;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", DarkGray, SamsaraFlashLightAmmoDisplay, Alignment(Center), DrawShadow, -67, 98, 2;
                } else {
                    DrawImage "NIVI_HUD", -66, 58, Center;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", DarkGray, SamsaraFlashLightAmmoDisplay, Alignment(Center), DrawShadow, -67, 82, 2;
                }

                InInventory SamsaraHalfLifeCanLongJump
                {
                    IfCVarInt goh_showtimer, 1, equal { DrawImage "HW00A0", -66, 142, Center; }
                    else { DrawImage "HW00A0", -66, 126, Center; }
                }
            }

            InInventory PainkillerClass // PKSOULS_HUD is placeholder
            {
                IfCVarInt goh_showtimer, 1, equal
                {
                    DrawImage "PKSOULS_HUD", -66, 74, Center;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Brown, Painkiller_SoulCount, Alignment(Center), DrawShadow, -67, 98, 2;
                } else {
                    DrawImage "PKSOULS_HUD", -66, 58, Center;
                    DrawNumber 4, "fonts/goodolhud_font.bmf", Brown, Painkiller_SoulCount, Alignment(Center), DrawShadow, -67, 82, 2;
                }
            }

            InInventory DescentClass
            {
                InInventory DescentQuadLaser
                {
                    IfCVarInt goh_showtimer, 1, equal { DrawImage "DS57_HUD", -66, 74, Center; }
                    else { DrawImage "DS57_HUD", -66, 58, Center; }
                }
            }

            InInventory DeusExClass
            {
                InInventory DeusEx_AugmentationUpgradeCannister
                {
                    IfCVarInt goh_showtimer, 1, equal
                    {
                        DrawImage "DXAUGCAN_HUD", -66, 74, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Cyan, DeusEx_AugmentationUpgradeCannister, Alignment(Center), DrawShadow, -67, 98, 2;
                    } else {
                        DrawImage "DXAUGCAN_HUD", -66, 58, Center;
                        DrawNumber 4, "fonts/goodolhud_font.bmf", Cyan, DeusEx_AugmentationUpgradeCannister, Alignment(Center), DrawShadow, -67, 82, 2;
                    }
                }

                InInventory DeusEx_AugmentationBioEnergyCell
                {
                    InInventory DeusEx_AugmentationUpgradeCannister
                    {
                        IfCVarInt goh_showtimer, 1, equal
                        {
                            DrawImage "DXAUGECL_HUD", -66, 142, Center;
                            DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, DeusEx_AugmentationBioEnergyCell, Alignment(Center), DrawShadow, -67, 166, 2;
                        } else {
                            DrawImage "DXAUGECL_HUD", -66, 126, Center;
                            DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, DeusEx_AugmentationBioEnergyCell, Alignment(Center), DrawShadow, -67, 150, 2;
                        }
                    } else {
                        IfCVarInt goh_showtimer, 1, equal
                        {
                            DrawImage "DXAUGECL_HUD", -66, 74, Center;
                            DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, DeusEx_AugmentationBioEnergyCell, Alignment(Center), DrawShadow, -67, 98, 2;
                        } else {
                            DrawImage "DXAUGECL_HUD", -66, 58, Center;
                            DrawNumber 4, "fonts/goodolhud_font.bmf", LightBlue, DeusEx_AugmentationBioEnergyCell, Alignment(Center), DrawShadow, -67, 82, 2;
                        }
                    }
