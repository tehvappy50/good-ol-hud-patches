                    else InInventory IpogMode, 3 { DrawImage "TPCHIPO4_HUD", 8, -58; }
                    else InInventory IpogMode, 2 { DrawImage "TPCHIPO3_HUD", 8, -58; }
                    else InInventory IpogMode, 1 { DrawImage "TPCHIPO2_HUD", 8, -58; }
                    else { DrawImage "TPCHIPOG_HUD", 8, -58; }
                }
                else InInventory DisruptorClass { DrawImage "TPCHJACK_HUD", 8, -58; }
                else InInventory WitchavenClass { DrawImage "TPCHWTCH_HUD", 8, -58; }
                else InInventory HalfLifeClass
                {
                    InInventory HalfLifeOpposingForce { DrawImage "TPCHSHEP_HUD", 8, -58; }
                    else { DrawImage "TPCHFREE_HUD", 8, -58; }
                }
                else InInventory SWClass { DrawImage "TPCHWANG_HUD", 8, -58; }
                else InInventory CMClass { DrawImage "TPCHCMDA_HUD", 8, -58; }
                else InInventory JonClass { DrawImage "TPCHPSEX_HUD", 8, -58; }
                else InInventory RRClass { DrawImage "TPCHLEON_HUD", 8, -58; }
                else InInventory BittermanClass { DrawImage "TPCHBITT_HUD", 8, -58; }
                else InInventory Hexen2Class { DrawImage "TPCHHEX2_HUD", 8, -58; }
                else InInventory BondClass
                {
                    InInventory Goldeneye_PlayerAltClassToken { DrawImage "TPCHFING_HUD", 8, -58; }
                    else { DrawImage "TPCHBOND_HUD", 8, -58; }
                }
                else InInventory CatacombClass { DrawImage "TPCHEVER_HUD", 8, -58; }
                else InInventory PainkillerClass { DrawImage "TPCHPAIN_HUD", 8, -58; }
                else InInventory UnrealClass { DrawImage "TPCHP849_HUD", 8, -58; }
                else InInventory RTCWClass { DrawImage "TPCHRTCW_HUD", 8, -58; }
                else InInventory Q3Class { DrawImage "TPCHQ3SG_HUD", 8, -58; }
                else InInventory DescentClass { DrawImage "TPCHPYRO_HUD", 8, -58; }
                else InInventory DeusExClass { DrawImage "TPCHDENT_HUD", 8, -58; }
            } else {
                IfCVarInt not goh_theme, 1 { DrawImage "graphics/hud/theme0/icons/goodolhud_icon_base.png", 6, -44; }
                else IfCVarInt goh_theme, 1 { DrawImage "graphics/hud/theme1/icons/goodolhud_icon_base.png", 6, -44; }

                InInventory DoomguyClass
                {
                    InInventory DoomClassMode, 2 { DrawImage "TPCHDOOM_HUD", 8, -42; }
                    else InInventory DoomClassMode, 1 { DrawImage "TPCHDG64_HUD", 8, -42; }
                    else { DrawImage "TPCHDOOM_HUD", 8, -42; }
                }
                else InInventory ChexClass { DrawImage "TPCHCHEX_HUD", 8, -42; }
                else InInventory CorvusClass { DrawImage "TPCHCORV_HUD", 8, -42; }
                else InInventory WolfenClass
                {
                    InInventory WolfenClassMode, 2 { DrawImage "TPCHWOL3_HUD", 8, -42; }
                    else InInventory WolfenClassMode, 1 { DrawImage "TPCHWOL2_HUD", 8, -42; }
                    else { DrawImage "TPCHWOLF_HUD", 8, -42; }
                } else InInventory HexenClass {
                    InInventory HexenClassMode, 3 { DrawImage "TPCHHEXF_HUD", 8, -42; }
                    else InInventory HexenClassMode, 2 { DrawImage "TPCHHEXM_HUD", 8, -42; }
                    else { DrawImage "TPCHHEXN_HUD", 8, -42; }
                } else InInventory DukeClass {
                    InInventory DukeClassMode, 2 { DrawImage "TPCHDUKE_HUD", 8, -42; }
                    else InInventory DukeClassMode, 1 { DrawImage "TPCHDLAB_HUD", 8, -42; }
                    else { DrawImage "TPCHDUKE_HUD", 8, -42; }
                }
                else InInventory MarathonClass { DrawImage "TPCHMARA_HUD", 8, -42; }
                else InInventory QuakeClass { DrawImage "TPCHQUAK_HUD", 8, -42; }
                else InInventory RottClass
                {
                    InInventory RottMode, 4 { DrawImage "TPCHDOUG_HUD", 8, -42; }
                    else InInventory RottMode, 3 { DrawImage "TPCHLLNI_HUD", 8, -42; }
                    else InInventory RottMode, 2 { DrawImage "TPCHTBAR_HUD", 8, -42; }
                    else InInventory RottMode, 1 { DrawImage "TPCHTCAS_HUD", 8, -42; }
                    else { DrawImage "TPCHROTT_HUD", 8, -42; }
                }
                else InInventory BlakeClass { DrawImage "TPCHBSTN_HUD", 8, -42; }
                else InInventory CalebClass { DrawImage "TPCHBLOD_HUD", 8, -42; }
                else InInventory StrifeClass { DrawImage "TPCHSTRF_HUD", 8, -42; }
                else InInventory EradClass
                {
                    InInventory EradMode, 3 { DrawImage "TPCHERA4_HUD", 8, -42; }
                    else InInventory EradMode, 2 { DrawImage "TPCHERA3_HUD", 8, -42; }
                    else InInventory EradMode, 1 { DrawImage "TPCHERA2_HUD", 8, -42; }
                    else { DrawImage "TPCHERAD_HUD", 8, -42; }
                }
                else InInventory C7Class { DrawImage "TPCHCOR7_HUD", 8, -42; }
                else InInventory RMRClass { DrawImage "TPCHRMR_HUD", 8, -42; }
                else InInventory KatarnClass { DrawImage "TPCHKYLE_HUD", 8, -42; }
                else InInventory POGreedClass
                {
                    InInventory IpogMode, 4 { DrawImage "TPCHIPO5_HUD", 8, -42; }
                    else InInventory IpogMode, 3 { DrawImage "TPCHIPO4_HUD", 8, -42; }
                    else InInventory IpogMode, 2 { DrawImage "TPCHIPO3_HUD", 8, -42; }
                    else InInventory IpogMode, 1 { DrawImage "TPCHIPO2_HUD", 8, -42; }
                    else { DrawImage "TPCHIPOG_HUD", 8, -42; }
                }
                else InInventory DisruptorClass { DrawImage "TPCHJACK_HUD", 8, -42; }
                else InInventory WitchavenClass { DrawImage "TPCHWTCH_HUD", 8, -42; }
                else InInventory HalfLifeClass
                {
                    InInventory HalfLifeOpposingForce { DrawImage "TPCHSHEP_HUD", 8, -42; }
                    else { DrawImage "TPCHFREE_HUD", 8, -42; }
                }
                else InInventory SWClass { DrawImage "TPCHWANG_HUD", 8, -42; }
                else InInventory CMClass { DrawImage "TPCHCMDA_HUD", 8, -42; }
                else InInventory JonClass { DrawImage "TPCHPSEX_HUD", 8, -42; }
                else InInventory RRClass { DrawImage "TPCHLEON_HUD", 8, -42; }
                else InInventory BittermanClass { DrawImage "TPCHBITT_HUD", 8, -42; }
                else InInventory Hexen2Class { DrawImage "TPCHHEX2_HUD", 8, -42; }
                else InInventory BondClass
                {
                    InInventory Goldeneye_PlayerAltClassToken { DrawImage "TPCHFING_HUD", 8, -42; }
                    else { DrawImage "TPCHBOND_HUD", 8, -42; }
                }
                else InInventory CatacombClass { DrawImage "TPCHEVER_HUD", 8, -42; }
                else InInventory PainkillerClass { DrawImage "TPCHPAIN_HUD", 8, -42; }
                else InInventory UnrealClass { DrawImage "TPCHP849_HUD", 8, -42; }
                else InInventory RTCWClass { DrawImage "TPCHRTCW_HUD", 8, -42; }
                else InInventory Q3Class { DrawImage "TPCHQ3SG_HUD", 8, -42; }
                else InInventory DescentClass { DrawImage "TPCHPYRO_HUD", 8, -42; }
                else InInventory DeusExClass { DrawImage "TPCHDENT_HUD", 8, -42; }
